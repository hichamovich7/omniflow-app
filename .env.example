#################################################
# App
#################################################

NEXT_PUBLIC_APP_URL=http://localhost:3000

#################################################
# Supabase
#################################################

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

#################################################
# Admin
#################################################

# Email of the account allowed to access /admin/bypass and manage
# rate_limit_bypass (TASK-029). Server-side only, never exposed to the client.
# Also shown to users who hit the trial limit below ("contact ... to continue").
ADMIN_EMAIL=

# Lightweight lifetime cap on AI-cost-incurring generation calls per account
# (profiles.total_generations_used, migration 023) — distinct from the future
# Credits System (TASK-011/012, still PLANNED). Protects against cost
# accumulation on test/trial accounts. Defaults to 10 if unset. See
# docs/DECISIONS.md for the cost math behind the default.
TRIAL_GENERATION_LIMIT=

#################################################
# AI Engine
#################################################

# FAST → Pinterest Package (Title, Description, Tags, Board, Creative Brief)
AI_FAST_PROVIDER=openrouter
AI_FAST_MODEL=openai/gpt-5-mini

# SMART → Future complex reasoning (SEO, AI Agents, Research)
AI_SMART_PROVIDER=openrouter
AI_SMART_MODEL=openai/gpt-5

# OUTLINE → WordPress article outline only (the full article stays on FAST).
# Optional: empty/unset → the whole FAST config above is used (AI_OUTLINE_PROVIDER
# alone is ignored). Example: AI_OUTLINE_MODEL=openai/gpt-6-luna
AI_OUTLINE_PROVIDER=openrouter
AI_OUTLINE_MODEL=

# VISION → Reference image analysis
AI_VISION_PROVIDER=openrouter
AI_VISION_MODEL=openai/gpt-5

# IMAGE → Image generation
AI_IMAGE_PROVIDER=openai
AI_IMAGE_MODEL=gpt-image-1

# IMAGE (text-overlay pins only) → forced through OpenRouter regardless of
# AI_IMAGE_PROVIDER/AI_IMAGE_MODEL above, using OPENROUTER_IMAGE_API_KEY
# below. See docs/DECISIONS.md (niche visual conventions / text overlay routing).
# REQUIRED for any text-overlay generation — no hardcoded fallback (TASK-FIX-030).
# Leaving this unset/commented throws at generation time instead of silently
# defaulting to a model chosen without the operator's knowledge.
# Example: AI_IMAGE_MODEL_TEXT=google/gemini-3.1-flash-image
AI_IMAGE_MODEL_TEXT=

#################################################
# Provider API Keys
#################################################

OPENROUTER_API_KEY=
# Used by lib/ai/providers/openrouter.ts generateImage() — required whenever
# AI_IMAGE_PROVIDER=openrouter, and always for text-overlay pins (AI_IMAGE_MODEL_TEXT above).
OPENROUTER_IMAGE_API_KEY=
OPENAI_API_KEY=

#################################################
# WordPress Publishing (TASK-035)
#################################################

# Encrypts stored WordPress Application Passwords (AES-256-GCM, lib/wordpress/crypto.ts).
# 32 bytes, hex-encoded (64 hex characters). Generate with: openssl rand -hex 32
# Server-side only, never exposed to the client. Never commit the real value —
# rotating it invalidates every stored WordPress connection (users would need
# to reconnect).
WORDPRESS_ENCRYPTION_KEY=

#################################################
# Media Storage (TASK-049)
#################################################

# Where NEW public media (Pinterest / WordPress images) are written:
# supabase (default — unchanged behavior) or r2 (Cloudflare R2). Existing
# Supabase URLs are never migrated. With r2, a missing R2 variable fails the
# generation explicitly — there is no silent fallback to Supabase.
# Pinterest `.source` photos (private) always stay in Supabase.
MEDIA_STORAGE_PROVIDER=supabase

# Cloudflare R2 — server-side only, never NEXT_PUBLIC_. Never commit real keys.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=omniflow-media
R2_PUBLIC_URL=https://media.n8nflow.org
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

#################################################
# Facebook Pages (TASK-068)
#################################################

# Meta app (type Business) with Facebook Login. Server-side only, never
# NEXT_PUBLIC_. Declare the OAuth redirect URI in the Meta app:
#   <NEXT_PUBLIC_APP_URL>/api/social/connections/facebook/oauth/callback
# Without these variables Facebook posts can still be generated and copied,
# but no Page can be connected and nothing can be published.
META_APP_ID=
META_APP_SECRET=
# Optional — defaults to v25.0.
META_GRAPH_API_VERSION=

# Encrypts stored Facebook Page access tokens (AES-256-GCM). Separate from
# WORDPRESS_ENCRYPTION_KEY. 32 bytes, hex-encoded (64 hex characters).
# Generate with: openssl rand -hex 32. Never commit the real value — rotating
# it invalidates every stored Page connection (users reconnect their Page).
SOCIAL_TOKEN_ENCRYPTION_KEY=

#################################################
# Future Providers (Reserved)
#################################################

FAL_API_KEY=
HIGHFIELD_API_KEY=

#################################################
# Stripe
#################################################

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

#################################################
# Future
#################################################

# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=